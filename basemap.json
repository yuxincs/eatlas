{
  "version": 8,
  "name": "Eatlas Light",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://vector.openstreetmap.org/shortbread_v1/tilejson.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2f1ef"
      }
    },
    {
      "id": "green-land",
      "type": "fill",
      "source": "osm",
      "source-layer": "land",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "park",
            "forest",
            "wood",
            "grass",
            "grassland",
            "meadow",
            "recreation_ground",
            "village_green",
            "garden",
            "nature_reserve"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#e4e9e2"
      }
    },
    {
      "id": "green-sites",
      "type": "fill",
      "source": "osm",
      "source-layer": "sites",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "park",
            "forest",
            "wood",
            "grass",
            "grassland",
            "meadow",
            "recreation_ground",
            "village_green",
            "garden",
            "nature_reserve"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#e4e9e2"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "osm",
      "source-layer": "ocean",
      "paint": {
        "fill-color": "#cdd7dc"
      }
    },
    {
      "id": "water_polygons",
      "type": "fill",
      "source": "osm",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#cdd7dc"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "osm",
      "source-layer": "water_lines",
      "paint": {
        "line-color": "#cdd7dc",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.5,
          16,
          3
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e5e3e0",
        "fill-outline-color": "#dedcd9",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          15,
          0.8
        ]
      }
    },
    {
      "id": "piers",
      "type": "fill",
      "source": "osm",
      "source-layer": "pier_polygons",
      "paint": {
        "fill-color": "#f2f1ef"
      }
    },
    {
      "id": "street-areas",
      "type": "fill",
      "source": "osm",
      "source-layer": "street_polygons",
      "paint": {
        "fill-color": "#ffffff"
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "rail"
          ],
          true
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "motorway",
              "trunk",
              "primary",
              "secondary",
              "tertiary",
              "unclassified",
              "residential",
              "living_street",
              "service",
              "road"
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#deddda",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          5,
          0.7,
          10,
          1.6,
          13,
          3.5,
          16,
          11,
          19,
          33
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "osm",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "rail"
          ],
          true
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "motorway",
              "trunk",
              "primary",
              "secondary",
              "tertiary",
              "unclassified",
              "residential",
              "living_street",
              "service",
              "road"
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          5,
          0.4,
          10,
          1,
          13,
          2.5,
          16,
          9,
          19,
          30
        ]
      }
    },
    {
      "id": "street-names",
      "type": "symbol",
      "source": "osm",
      "source-layer": "street_labels",
      "minzoom": 14,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "unclassified",
            "residential",
            "living_street",
            "road"
          ]
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          10,
          18,
          12
        ],
        "text-max-angle": 30,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#858b90",
        "text-halo-color": "#f7f7f5",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water-names",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_polygons_labels",
      "minzoom": 11,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-letter-spacing": 0.08,
        "text-padding": 35
      },
      "paint": {
        "text-color": "#8b9ba4",
        "text-halo-color": "#d7e0e4",
        "text-halo-width": 1
      }
    },
    {
      "id": "city-names",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "maxzoom": 13,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "city",
            "town",
            "village"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          11,
          12,
          16
        ],
        "text-padding": 15
      },
      "paint": {
        "text-color": "#858b90",
        "text-halo-color": "#f7f7f5",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "neighborhood-names",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place_labels",
      "minzoom": 12,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "suburb",
            "quarter",
            "neighbourhood",
            "borough"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_en"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.13,
        "text-size": 11,
        "text-padding": 30
      },
      "paint": {
        "text-color": "#8e9395",
        "text-halo-color": "#f7f7f5",
        "text-halo-width": 1.5
      }
    }
  ]
}
